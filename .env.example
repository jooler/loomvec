# LoomVec API / Worker 共用配置（复制为 .env 使用；所有变量前缀 LOOMVEC_，嵌套用 __）
# ---- 运行环境 ----
LOOMVEC_ENV=dev
LOOMVEC_LOG_LEVEL=INFO
# dev 控制台想看人类可读日志时改为 false
LOOMVEC_LOG_JSON=true

# ---- PostgreSQL 18 + Apache AGE ----
# compose 栈映射到 5433（见 deploy/compose/.env），本机直连时改为 5432
LOOMVEC_POSTGRES__URL=postgresql+asyncpg://loomvec:loomvec@localhost:5433/loomvec

# ---- Redis（broker/缓存/限流） ----
LOOMVEC_REDIS__URL=redis://localhost:6379/0

# ---- Milvus 2.6 Standalone ----
LOOMVEC_MILVUS__URI=http://localhost:19530

# ---- RustFS（S3 兼容对象存储） ----
LOOMVEC_STORAGE__ENDPOINT=http://localhost:9000
LOOMVEC_STORAGE__ACCESS_KEY=loomvec
LOOMVEC_STORAGE__SECRET_KEY=loomvec-secret
LOOMVEC_STORAGE__BUCKET_RAW=loomvec-raw
LOOMVEC_STORAGE__BUCKET_DERIVED=loomvec-derived

# ---- MinerU 解析服务（mineru-api） ----
LOOMVEC_MINERU__BASE_URL=http://localhost:8000
LOOMVEC_MINERU__BACKEND=pipeline

# ---- 认证（P0 dev 模式；生产必须关闭 dev_mode 并换强随机 jwt_secret） ----
LOOMVEC_AUTH__DEV_MODE=true
LOOMVEC_AUTH__JWT_SECRET=dev-only-secret-change-me

# ---- 安全加固（P4-INF-04；策略见 services/api/src/loomvec/api/ratelimit.py） ----
# 全局固定窗口限流（按身份计数，Redis 不可用时 fail-open）
# LOOMVEC_SECURITY__RATE_LIMIT_ENABLED=true
# LOOMVEC_SECURITY__RATE_LIMIT_PER_MIN=300
# LOOMVEC_SECURITY__ANONYMOUS_WRITE_ALLOWED=false

# ---- OIDC SSO（P4-API-06；租户级绑定经运维端 /admin/tenants/{id}/oidc-binding 配置） ----
# 平台级默认 IdP（租户未绑域时兜底）经管理 API 写入 system_config（sso.* 组）
# 测试 IdP：docker compose --profile sso up keycloak（deploy/compose/keycloak/loomvec-realm.json）

# ---- 监控告警（P4-INF-01；./dev.sh obs 或 docker compose --profile observability up） ----
# 注意：以下端口变量供 deploy/compose/.env 使用；critical 告警 webhook 地址不在此配置，
# 直接修改 deploy/monitoring/alertmanager.yml（Alertmanager 不支持配置内环境变量替换）。
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3002
# GRAFANA_ADMIN_PASSWORD=admin        # 生产必改
# LOKI_PORT=3100
# ALERTMANAGER_PORT=9093

# ---- 测试 IdP（P4-QA-02 Keycloak，仅 sso profile） ----
# KEYCLOAK_PORT=8088

# ---- AI 供方网关（OpenAI 兼容；P1 使用，密钥只经环境变量注入） ----
# mock=true 时全部通道走确定性本地实现（无外网/密钥，生产禁止开启）
LOOMVEC_AI__MOCK=true
# LOOMVEC_AI__EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LOOMVEC_AI__EMBEDDING__API_KEY=sk-xxx
# LOOMVEC_AI__EMBEDDING__MODEL=text-embedding-v4
# LOOMVEC_AI__EMBEDDING__DIM=1024          # 更换模型/维度需删除 Milvus semantic_units 集合重建
# LOOMVEC_AI__EMBEDDING__DIMENSIONS=2048    # 可选：自定义输出维度（须与 DIM 一致并重建集合）
# LOOMVEC_AI__EMBEDDING__BATCH_SIZE=16
# LOOMVEC_AI__LLM__BASE_URL=
# LOOMVEC_AI__LLM__API_KEY=
# LOOMVEC_AI__LLM__MODEL=
# LOOMVEC_AI__RERANK__BASE_URL=            # /rerank（Cohere/Jina 风格）；不配置则检索跳过精排
# LOOMVEC_AI__RERANK__API_KEY=
# LOOMVEC_AI__RERANK__MODEL=
# LOOMVEC_AI__RERANK__API_STYLE=openai     # 百炼 rerank 无兼容端点：填 dashscope（base_url 填 .../api/v1）
# ---- P2-CORE-05 clip 图文向量通道（BGE-VL 类；以文搜图） ----
# 契约：OpenAI 兼容 /embeddings，input 为 [{"text":...}|{"image":"<base64>"}] 混合列表
# LOOMVEC_AI__CLIP__BASE_URL=
# LOOMVEC_AI__CLIP__API_KEY=
# LOOMVEC_AI__CLIP__MODEL=
# LOOMVEC_AI__CLIP__DIM=512                # Milvus clip_dense 向量维度
# ---- P2 VLM caption（图片描述生成；ai.mock=true 时走本地确定性实现） ----
# LOOMVEC_AI__VLM__BASE_URL=
# LOOMVEC_AI__VLM__API_KEY=
# LOOMVEC_AI__VLM__MODEL=
# LOOMVEC_AI__MOCK_IMPL__CHUNK_WINDOW_LINES=12  # mock 分片粒度（仅 mock=true）

# ---- 混合检索（P1-CORE-03 / P2-CORE-02；默认值即为下列值，按需覆盖） ----
# LOOMVEC_SEARCH__DEFAULT_TOP_K=10
# LOOMVEC_SEARCH__DENSE_TOP_K=50
# LOOMVEC_SEARCH__SPARSE_TOP_K=50
# LOOMVEC_SEARCH__RRF_K=60
# LOOMVEC_SEARCH__RERANK_ENABLED=true
# LOOMVEC_SEARCH__RERANK_CANDIDATES=30
# LOOMVEC_SEARCH__IMAGE_SEARCH_ENABLED=true  # clip_dense 以文搜图召回路（clip 未配置自动降级）
# LOOMVEC_SEARCH__GRAPH_ENABLED=true  # P3 图谱召回 L3/L4（运维可经 SystemConfig(graph.enabled) 运行时关停）

# ---- P3 图谱管线（P3-CORE；默认值即为下列值，按需覆盖） ----
# LOOMVEC_GRAPH__ENABLED=true  # 图谱总开关（写入与召回联动；关闭即纯 L1/L2）
# LOOMVEC_GRAPH__EXTRACTION_ENABLED=true  # 合并抽取开关
# LOOMVEC_GRAPH__ENTITY_LINK_THRESHOLD=0.90  # 阶段一内联链接向量阈值
# LOOMVEC_GRAPH__MERGE_THRESHOLD=0.94  # 阶段二空间合并向量阈值
# LOOMVEC_GRAPH__MERGE_NAME_DISTANCE=2  # 规范名编辑距离候选阈值
# LOOMVEC_GRAPH__MERGE_TRIGGER_DELTA=20  # 实体增量达阈值触发空间合并
# LOOMVEC_GRAPH__EXPAND_HOPS=2  # L3 扩展跳数（1~2）
# LOOMVEC_GRAPH__ADJACENCY_ENABLED=true  # 命中 chunk 的 1 跳邻接补全
# LOOMVEC_GRAPH__MERGE_INTERVAL_SECONDS=1800  # 空间合并周期扫描（beat）
# LOOMVEC_GRAPH__COMMUNITY_INTERVAL_SECONDS=3600  # 社区任务周期扫描（beat）

# ---- P3 视频/音频管线（P3-WRK-03/04/05；ffmpeg 走系统二进制） ----
# LOOMVEC_MEDIA__SCENE_THRESHOLD=27.0  # 场景切分阈值
# LOOMVEC_MEDIA__MIN_SCENE_SECONDS=3.0
# LOOMVEC_MEDIA__MAX_SCENES_PER_ASSET=200
# LOOMVEC_MEDIA__KEYFRAME_WIDTH=640
# LOOMVEC_MEDIA__TRANSCODE_ENABLED=true  # 懒转码（首次播放触发 H.264/AAC 转码）
# LOOMVEC_MEDIA__TRANSCODE_HEIGHT=720

# ---- P3 音频转写（faster-whisper；未安装可选依赖 loomvec-core[media] 时跳过转写） ----
# LOOMVEC_TRANSCRIBE__ENABLED=true
# LOOMVEC_TRANSCRIBE__MODEL_SIZE=base
# LOOMVEC_TRANSCRIBE__DEVICE=cpu
# LOOMVEC_TRANSCRIBE__COMPUTE_TYPE=int8
# LOOMVEC_TRANSCRIBE__SEGMENT_MAX_CHARS=400

# ---- P3 问答（P3-CORE-05；LLM 未配置时问答入口自动禁用，检索不受影响） ----
# LOOMVEC_QA__ENABLED=true
# LOOMVEC_QA__RETRIEVAL_TOP_K=8  # 送入 prompt 的引用上限
# LOOMVEC_QA__HISTORY_MESSAGES=6  # 携带历史消息条数
# LOOMVEC_QA__MAX_ANSWER_TOKENS=1024

# ---- 管线（P1-WRK；分片钳制 / LLM 分批 / 嵌入批处理 / 截断上限 / 可选摘要） ----
# LOOMVEC_PIPELINE__CHUNK_MIN_CHARS=120
# LOOMVEC_PIPELINE__CHUNK_MAX_CHARS=2000
# LOOMVEC_PIPELINE__LLM_BATCH_CHARS=6000
# LOOMVEC_PIPELINE__EMBED_BATCH_SIZE=16
# LOOMVEC_PIPELINE__EMBED_TEXT_MAX_CHARS=6000   # 嵌入输入截断
# LOOMVEC_PIPELINE__INDEX_TEXT_MAX_CHARS=30000  # Milvus 索引正文截断
# LOOMVEC_PIPELINE__SUMMARY_ENABLED=false

# ---- Worker（P1-WRK-01；队列拓扑见 core/constants.py） ----
# LOOMVEC_WORKER__HEARTBEAT_INTERVAL_SECONDS=30
# LOOMVEC_WORKER__TASK_SOFT_TIME_LIMIT=3500
# LOOMVEC_WORKER__TASK_TIME_LIMIT=3600
# LOOMVEC_WORKER__METRICS_PORT=9808  # Prometheus 指标端口（0=关闭；抓取配置见 deploy/monitoring/prometheus.yml）

# ---- 上传白名单（P1-API-01；默认值见 core/config.py UploadSettings） ----
# LOOMVEC_UPLOAD__MAX_SIZE_BYTES=209715200
# LOOMVEC_UPLOAD__ALLOWED_EXTENSIONS=[".pdf",".docx",".pptx",".xlsx",".txt",".md",".markdown",".jpg",".jpeg",".png",".webp",".gif",".bmp",".mp4",".mov",".webm",".mkv",".mp3",".wav",".m4a",".flac"]

# ---- 图片处理（P2-CORE-05 / P2-WRK-01；缩略图后端 pyvips 优先、Pillow 兜底） ----
# LOOMVEC_IMAGE__THUMBNAIL_MAX_WIDTH=480
# LOOMVEC_IMAGE__THUMBNAIL_MAX_HEIGHT=480
# LOOMVEC_IMAGE__THUMBNAIL_FORMAT=webp
# LOOMVEC_IMAGE__THUMBNAIL_QUALITY=82
# LOOMVEC_IMAGE__CAPTION_ENABLED=true      # VLM caption 开关
# LOOMVEC_IMAGE__EXIF_WHITELIST=["Make","Model","LensModel","DateTimeOriginal","ExposureTime","FNumber","ISO","FocalLength","Orientation","GPSLatitude","GPSLongitude","ImageWidth","ImageHeight"]

# ---- OpenTelemetry（未配置则不导出 trace） ----
# LOOMVEC_OTEL__ENDPOINT=http://localhost:4317

