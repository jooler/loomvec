# LoomVec 基础设施与运行环境（复制为 .env 使用；所有变量前缀 LOOMVEC_，嵌套用 __）
#
# 配置分层（来源唯一，详见 docs/02 §二）：
# - 本文件：基础设施连接（PG/Redis/Milvus/对象存储）、运行环境、认证密钥、
#   限流、worker 运行参数、OTel、服务端口；
# - 应用运行参数（模型地址/key、MinerU、检索、分片参数、上传白名单等）：
#   config/loomvec.json（应用自管理；模板 config/loomvec.example.json，
#   路径经 LOOMVEC_APP_CONFIG 指定）——env 中不配置这些参数；
# - admin 动态配置（DB system_config）：管理端集中管理的运营可调项，
#   未配置回落 config/loomvec.json，不回落环境变量。

# ---- 运行环境 ----
LOOMVEC_ENV=dev
LOOMVEC_LOG_LEVEL=INFO
# dev 控制台想看人类可读日志时改为 false
LOOMVEC_LOG_JSON=true

# ---- 服务端口（部署时灵活调整） ----
LOOMVEC_API_PORT=38080
LOOMVEC_WEB_PORT=35173
LOOMVEC_ADMIN_PORT=35174
LOOMVEC_OPS_PORT=35175
# 应用参数文件路径（缺省 <仓库根>/config/loomvec.json）
# LOOMVEC_APP_CONFIG=config/loomvec.json

# ---- PostgreSQL 18 + Apache AGE ----
# compose 栈宿主机端口默认 35433（见 deploy/compose/.env）；勿指向本机系统 PostgreSQL 的 5432
LOOMVEC_POSTGRES__URL=postgresql+asyncpg://loomvec:loomvec@localhost:35433/loomvec

# ---- Redis（broker/缓存/限流） ----
LOOMVEC_REDIS__URL=redis://localhost:36379/0

# ---- Milvus 2.6 Standalone ----
LOOMVEC_MILVUS__URI=http://localhost:39530

# ---- RustFS（S3 兼容对象存储） ----
LOOMVEC_STORAGE__ENDPOINT=http://localhost:39000
LOOMVEC_STORAGE__ACCESS_KEY=loomvec
LOOMVEC_STORAGE__SECRET_KEY=loomvec-secret
LOOMVEC_STORAGE__BUCKET_RAW=loomvec-raw
LOOMVEC_STORAGE__BUCKET_DERIVED=loomvec-derived
# 浏览器直传桶级 CORS 允许来源（JSON 数组；默认 ["*"]，生产收紧为前端来源）
# LOOMVEC_STORAGE__CORS_ALLOWED_ORIGINS=["http://localhost:35175"]

# ---- 认证（P0 dev 模式；生产必须关闭 dev_mode 并换强随机 jwt_secret） ----
LOOMVEC_AUTH__DEV_MODE=true
LOOMVEC_AUTH__JWT_SECRET=dev-only-secret-change-me

# ---- 安全加固（P4-INF-04；策略见 services/api/src/loomvec/api/ratelimit.py） ----
# 全局固定窗口限流（按身份计数，Redis 不可用时 fail-open）
# LOOMVEC_SECURITY__RATE_LIMIT_ENABLED=true
# LOOMVEC_SECURITY__RATE_LIMIT_PER_MIN=300
# LOOMVEC_SECURITY__ANONYMOUS_WRITE_ALLOWED=false

# ---- Worker（P1-WRK-01；队列拓扑见 core/constants.py） ----
# LOOMVEC_WORKER__HEARTBEAT_INTERVAL_SECONDS=30
# LOOMVEC_WORKER__TASK_SOFT_TIME_LIMIT=3500
# LOOMVEC_WORKER__TASK_TIME_LIMIT=3600
# ---- P5 智能体网关（services/agent；dsh 智能体对话，14 文档） ----
# LOOMVEC_AGENT_PORT=38090                        # agent 服务端口（内网 only）
# LOOMVEC_AGENT_SERVICE__SERVICE_URL=http://127.0.0.1:38090  # api facade 转发目标（pydantic 嵌套：LOOMVEC_ + __）
# LOOMVEC_AGENT_SERVICE__INTERNAL_TOKEN=dev-internal-token  # api ↔ agent 内部共享密钥（生产必改，生产为默认值时拒绝启动）
# LOOMVEC_AGENT_STORAGE_ROOT=                    # env 目录树根（K8s PVC 挂载路径；缺省用 config/loomvec.json agent.storage_root）

# LOOMVEC_WORKER__METRICS_PORT=39808  # Prometheus 指标端口（0=关闭）

# ---- OpenTelemetry（未配置则不导出 trace） ----
# LOOMVEC_OTEL__ENDPOINT=http://localhost:34317

# ---- 监控告警（P4-INF-01；./dev.sh obs 或 docker compose --profile observability up） ----
# 以下端口变量供 deploy/compose/.env 使用；critical 告警 webhook 地址不在此配置，
# 直接修改 deploy/monitoring/alertmanager.yml（Alertmanager 不支持配置内环境变量替换）。
# PROMETHEUS_PORT=39090
# GRAFANA_PORT=33002
# GRAFANA_ADMIN_PASSWORD=admin        # 生产必改
# LOKI_PORT=33100
# ALERTMANAGER_PORT=39093

# ---- 测试 IdP（P4-QA-02 Keycloak，仅 sso profile） ----
# KEYCLOAK_PORT=38088

# ---- OIDC SSO（P4-API-06） ----
# 平台级默认 IdP（租户未绑域时兜底）经管理 API 写入 system_config（sso.* 组）；
# 测试 IdP：docker compose --profile sso up keycloak（deploy/compose/keycloak/loomvec-realm.json）
