# LoomVec compose 基础设施栈环境变量（复制为 .env 使用）
POSTGRES_USER=loomvec
POSTGRES_PASSWORD=loomvec
POSTGRES_DB=loomvec
# 宿主机端口默认 35433（本机系统 PostgreSQL 占 5432，回退 5432 会互相混淆）
POSTGRES_PORT=35433

REDIS_PORT=36379

RUSTFS_ACCESS_KEY=loomvec
RUSTFS_SECRET_KEY=loomvec-secret
RUSTFS_PORT=39000
RUSTFS_CONSOLE_PORT=39001

MILVUS_PORT=39530
MILVUS_METRICS_PORT=39091

MINERU_PORT=38000

# ---- P5.5a 沙箱（agent-sandbox 网络与防火墙脚本单源子网） ----
AGENT_SANDBOX_SUBNET=172.31.77.0/24
# 宿主机 services/api 端口（沙箱 → 宿主 INPUT 白名单唯一放行口，MCP 回调）
AGENT_SANDBOX_API_PORT=38080

# ---- 可选 profile（debug / sso / observability） ----
ATTU_PORT=33001
KEYCLOAK_PORT=38088
PROMETHEUS_PORT=39090
ALERTMANAGER_PORT=39093
GRAFANA_PORT=33002
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=33100

# ---- 可选 profile：gateway（acp-gateway 智能体网关；启动与前置条件见 compose.yaml 的 acp-gateway 段） ----
# 以下密钥只写 deploy/compose/.env（已 gitignore），不要提交；留空时网关在生产模式下拒绝启动
ACPGW_SECRET_KEY=
ACPGW_ADMIN_TOKEN=
ACPGW_ANTHROPIC_API_KEY=
ACPGW_DEEPSEEK_API_KEY=
# 沙箱网段（acpgw-sandbox 网络与防火墙脚本单源子网）；须避开 AGENT_SANDBOX_SUBNET。
# 该子网的防火墙只用 deploy/compose/sandbox-firewall.sh，端口传「api 端口,网关端口」：
#   sudo deploy/compose/sandbox-firewall.sh 172.31.88.0/24 38080,38095
# 外网策略是该脚本现有的（公网放行、私网/CGNAT/链路本地 DROP），不是网关脚本的 upstream-only
ACPGW_SANDBOX_SUBNET=172.31.88.0/24
# 网关工作区根目录：宿主上已存在、uid 1000 可写；以同一路径挂进容器，须与 acp-gateway/config.json 的 storage_root 一致
ACPGW_STORAGE_ROOT=/data/acp-gateway
# 宿主 docker 组 gid：stat -c %g /var/run/docker.sock
DOCKER_GID=999
# 缺省复用本栈 postgres（database acpgw，需先 CREATE）与 redis（db 1）；独立库时覆盖整条连接串
# ACPGW_DATABASE_URL=postgres://acpgw:<password>@127.0.0.1:5433/acpgw
# ACPGW_REDIS_URL=redis://127.0.0.1:6380
# ACPGW_GATEWAY_IMAGE=acpgw/gateway:0.1.0
# ACPGW_CONFIG_FILE=./acp-gateway/config.json
