# LoomVec compose 基础设施栈环境变量（复制为 .env 使用）
POSTGRES_USER=loomvec
POSTGRES_PASSWORD=loomvec
POSTGRES_DB=loomvec
# 宿主机端口固定 5433（本机系统 PostgreSQL 占 5432，勿改动）
POSTGRES_PORT=5433

REDIS_PORT=6379

RUSTFS_ACCESS_KEY=loomvec
RUSTFS_SECRET_KEY=loomvec-secret
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

MINERU_PORT=8000

# ---- 可选 profile（debug / sso / observability） ----
ATTU_PORT=3001
KEYCLOAK_PORT=8088
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
