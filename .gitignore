# OS / IDE
.DS_Store
.idea/
.vscode/
# ZCode 会话本地数据（会话记录/草稿等，仅本机有效）
.zcode/

# MinerU 本地解析输出
third_party/mineru/output/
# AGE 扩展源码（构建 postgres-age 镜像前经 `make age-src` 克隆，见 Makefile）
deploy/compose/postgres-age/age-src/
# compose 本机开发定制（如用 profile 关掉容器版 MinerU 改走宿主机 GPU；仅本机有效，不入库）
deploy/compose/compose.override.yaml
tmp/

# Celery beat 本地调度状态（运行时产物）
celerybeat-schedule.db
celerybeat-schedule.*.db

# 应用运行参数（含密钥；模板 config/loomvec.example.json 入库）
config/loomvec.json
