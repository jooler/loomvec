{
  "name": "@loomvec/sdk-ts",
  "version": "0.1.0",
  "private": true,
  "description": "LoomVec OpenAPI 生成的 TypeScript SDK（勿手写接口；由 packages/sdk-ts 生成流水线维护）",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json -o src/sdk/schema.d.ts",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "echo 'sdk-ts: no runtime tests' && exit 0"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0"
  }
}
